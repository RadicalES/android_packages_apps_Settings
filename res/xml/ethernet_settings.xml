<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="ethernet_settings_screen"
    android:title="@string/ethernet">

    <Preference
        android:key="ethernet_status"
        android:title="@string/ethernet_status_title"
        android:summary="@string/summary_placeholder"
        android:selectable="false"/>

    <PreferenceCategory
        android:key="ethernet_current_config"
        android:title="@string/ethernet_current_config_title">

        <Preference
            android:key="ethernet_current_ip"
            android:title="@string/wifi_ip_address"
            android:summary="@string/summary_placeholder"
            android:selectable="false"/>

        <Preference
            android:key="ethernet_current_gateway"
            android:title="@string/wifi_gateway"
            android:summary="@string/summary_placeholder"
            android:selectable="false"/>

        <Preference
            android:key="ethernet_current_dns"
            android:title="@string/ethernet_dns_title"
            android:summary="@string/summary_placeholder"
            android:selectable="false"/>

    </PreferenceCategory>

    <Preference
        android:key="ethernet_ip_settings"
        android:title="@string/wifi_ip_settings"
        android:summary="@string/summary_placeholder"/>

    <!-- Time sync is configured here because this is the screen a user is already on when setting
         up a static-address or locked-down network, which is where the NTP server most often needs
         changing. Applies to DHCP sites too, so it sits outside the IP
         configuration rather than inside the static-IP dialog. -->
    <PreferenceCategory
        android:key="ethernet_time"
        android:title="@string/ethernet_time_category_title">

        <Preference
            android:key="ethernet_ntp_server"
            android:title="@string/ethernet_ntp_title"
            android:summary="@string/summary_placeholder"/>

    </PreferenceCategory>

</PreferenceScreen>
